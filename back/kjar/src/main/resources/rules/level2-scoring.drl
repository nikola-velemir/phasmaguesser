// ============================================================
//  NIVO 2 — Skorovanje kandidata po poklapanju dokaza i osobina
//
//  Salience:
//    25  → Eliminacije (diskvalifikacije, -inf)
//    20  → Inicijalizacija GhostCandidate objekata
//    15  → Bodovanje dokaza (+1 po poklapanju, max +3)
//    12  → Bodovanje osobina (+1 po poklapanju)
// ============================================================


// ============================================================
//  INICIJALIZACIJA — jedan GhostCandidate po duhu
// ============================================================

rule "Init_Candidate_Spirit"       salience 20 when not GhostCandidate(ghostName == "Spirit")       then insert(new GhostCandidate("Spirit"));       end
rule "Init_Candidate_Wraith"       salience 20 when not GhostCandidate(ghostName == "Wraith")       then insert(new GhostCandidate("Wraith"));       end
