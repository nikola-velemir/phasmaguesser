// Mare — GHOST_ORB, GHOST_WRITING, SPIRIT_BOX
rule "Eliminate_Mare_By_EMF"
    salience 25
when
    $e : CurrentEvidence(
        confirmedEvidence contains Evidence.EMF_LEVEL_5,
        ruledOutEvidence not contains Evidence.GHOST_ORB,
        ruledOutEvidence not contains Evidence.GHOST_WRITING,
        ruledOutEvidence not contains Evidence.SPIRIT_BOX
    )
    // Mare nema EMF — prisustvo EMF5 isključuje Maru
    $c : GhostCandidate(ghostName == "Mare", eliminated == false)
then
    $c.eliminate();
    update($c);
    System.out.println("[Nivo 2] ELIMINISAN: Mare (EMF5 potvrđen, Mare ga nema)");
end

