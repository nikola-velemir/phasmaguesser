package com.ftn.sbnz.kjar.rules

import com.ftn.sbnz.model.ghosts.Ghost;
import com.ftn.sbnz.model.ghosts.GhostCandidate;
import com.ftn.sbnz.model.evidence.Evidence;
import com.ftn.sbnz.model.evidence.CurrentEvidence;
import com.ftn.sbnz.model.traits.DerivedTrait;
import com.ftn.sbnz.model.observations.HuntObservation;

// ============================================================================
//  NIVO 2 — Bodovanje dokaza + osobina + eliminacija
//  salience 20 → posle Nivoa 1 (salience 30), pre Nivoa 3 (salience 5)
// ============================================================================


// ----------------------------------------------------------------------------
//  KORAK 0 — Dinamička inicijalizacija kandidata (salience 150)
//  Za svakog duha u bazi kreira GhostCandidate ako već ne postoji.
// ----------------------------------------------------------------------------
rule "Init_Ghost_Candidates_Dynamically"
    salience 150
when
    $g : Ghost()
    not GhostCandidate(ghostName == $g.name)
then
    insert(new GhostCandidate($g.getName()));
    System.out.println("[Nivo 2 - INIT] Kreiran kandidat: " + $g.getName());
end


// ----------------------------------------------------------------------------
//  KORAK 1 — Eliminacija po dokazima (-inf)
//
//  Ako je igrač potvrdio dokaz koji ovaj duh NE MOŽE imati,
//  kandidat se eliminiše (eliminated = true, skor = -9999).
// ----------------------------------------------------------------------------

rule "Eliminate_Incompatible_Evidence"
    salience 140
when
    $input : CurrentEvidence()
    $confirmedEvidence : Evidence() from $input.getConfirmedEvidence()
    $g : Ghost(
        evidence1 != $confirmedEvidence,
        evidence2 != $confirmedEvidence,
        evidence3 != $confirmedEvidence
    )
    $c : GhostCandidate(
        ghostName == $g.name,
        eliminated == false,
        appliedRules not contains "Eliminated_By_Evidence"
    )
then
    $c.setEliminated(true);
    $c.addScore(-9999);
    $c.applyRule("Eliminated_By_Evidence");
    update($c);
    System.out.println("[Nivo 2 - ELIMINACIJA] " + $g.getName()
        + " eliminisan — nema dokaz: " + $confirmedEvidence);
end


// ----------------------------------------------------------------------------
//  KORAK 1b — Specijalna hard-eliminacija: Wraith + otisak u soli
//
//  Wraith NIKADA ne ostavlja otiske u soli. Ako je otisak nađen,
//  Wraith se eliminiše bez obzira na ostale dokaze.
// ----------------------------------------------------------------------------

rule "Eliminate_Wraith_Salt_Footprint"
    salience 140
when
    HuntObservation(saltPlaced == true, saltFootprintFound == true)
    $c : GhostCandidate(
        ghostName == "Wraith",
        eliminated == false,
        appliedRules not contains "Eliminate_Wraith_Salt_Footprint"
    )
then
    $c.setEliminated(true);
    $c.addScore(-9999);
    $c.applyRule("Eliminate_Wraith_Salt_Footprint");
    update($c);
    System.out.println("[Nivo 2 - ELIMINACIJA] Wraith eliminisan — otisak u soli nađen (nemoguće za Wraith).");
end


// ----------------------------------------------------------------------------
//  KORAK 2 — Bodovanje po potvrđenim dokazima (+1 po poklapanju)
//
//  Za svakog neelimisanog kandidata, za svaki potvrđeni dokaz koji taj
//  duh može imati → +1. Svaki dokaz se broji samo jednom.
// ----------------------------------------------------------------------------

rule "Score_Confirmed_Evidence"
    salience 20
when
    $input : CurrentEvidence()
    $confirmedEvidence : Evidence() from $input.getConfirmedEvidence()
    $g : Ghost(
        evidence1 == $confirmedEvidence ||
        evidence2 == $confirmedEvidence ||
        evidence3 == $confirmedEvidence
    )
    $c : GhostCandidate(
        ghostName == $g.name,
        eliminated == false,
        appliedRules not contains ("Evidence_" + $confirmedEvidence.toString())
    )
then
    $c.addScore(1);
    $c.applyRule("Evidence_" + $confirmedEvidence.toString());
    update($c);
    System.out.println("[Nivo 2 - DOKAZ] " + $g.getName()
        + " +1 za dokaz: " + $confirmedEvidence);
end


// ----------------------------------------------------------------------------
//  KORAK 3 — Bodovanje po izvedenim osobinama (+1 po poklapanju)
//
//  Originalna logika iz starog fajla — nepromenjena.
// ----------------------------------------------------------------------------

rule "Score_Ghost_Traits_Dynamically"
    salience 12
when
    DerivedTrait($derivedName : traitName)
    $g : Ghost(trait == $derivedName)
    $c : GhostCandidate(
        ghostName == $g.name,
        eliminated == false,
        appliedRules not contains $derivedName
    )
then
    $c.addScore(1);
    $c.applyRule($derivedName);
    update($c);
    System.out.println("[Nivo 2 - OSOBINA] " + $g.getName()
        + " +1 za osobinu: " + $derivedName);
end
