rule "Init_Candidate_Thaye"        salience 20 when not GhostCandidate(ghostName == "Thaye")        then insert(new GhostCandidate("Thaye"));        end


// ============================================================
//  ELIMINACIJE — automatska diskvalifikacija
//  Dokaz koji duh NIKADA ne može imati → -inf
// ============================================================

// Wraith nikada ne ostavlja otiske u soli
rule "Eliminate_Wraith_Salt_Footprint"
    salience 25
when
    HuntObservation(saltFootprintFound == true)
    $c : GhostCandidate(ghostName == "Wraith", eliminated == false)
then
    $c.eliminate();
    update($c);
    System.out.println("[Nivo 2] ELIMINISAN: Wraith (otisak u soli)");
end

// Goryo ne napušta svoju sobu ako ima žive igrače u blizini — DOTS vidljiv golim okom isključuje Goryo
rule "Eliminate_Goryo_Naked_Eye_DOTS"
    salience 25
when
    HuntObservation(dotsVisibleToNakedEye == true)
    $c : GhostCandidate(ghostName == "Goryo", eliminated == false)
then
    $c.eliminate();
    update($c);
    System.out.println("[Nivo 2] ELIMINISAN: Goryo (DOTS vidljiv golim okom)");
end

// Jinn ne može da smanji brzinu blizu osigurača — ako je osigurač uključen a duh nije ubrzao, Jinn je malo verovatno
// (ovo je soft eliminacija — ne -inf, samo odbijamo osobinu)

// Yokai lovi samo ako se govori — ako nema glasa ali je lovio, Yokai je manje verovatno
// (obrađeno u bodovanju, ne u eliminaciji jer nije apsolutno pravilo)

// Demon može loviti pri SVAKOM sanity-u — ne eliminišemo ga ni zbog čega

// Mimic uvek daje Ghost Orb kao lažni dokaz — ako je potvrđeno da nema Ghost Orb-a, The Mimic se eliminiše
rule "Eliminate_Mimic_No_Ghost_Orb"
    salience 25
when
    $e : CurrentEvidence(ruledOutEvidence contains Evidence.GHOST_ORB)
    $c : GhostCandidate(ghostName == "The Mimic", eliminated == false)
then
    $c.eliminate();
    update($c);
    System.out.println("[Nivo 2] ELIMINISAN: The Mimic (Ghost Orb isključen, a Mimic uvek ga daje)");
end

// Eliminacija po isključenim dokazima — ako igrač potvrdi da dokaz ne postoji
// i taj dokaz je jedan od tri za nekog duha → duh se eliminiše

// Spirit — EMF5, GHOST_WRITING, SPIRIT_BOX
rule "Eliminate_Spirit_By_Missing_Evidence"
    salience 25
when
    $e : CurrentEvidence(
        ruledOutEvidence contains Evidence.EMF_LEVEL_5,
        ruledOutEvidence contains Evidence.GHOST_WRITING
    )
    $c : GhostCandidate(ghostName == "Spirit", eliminated == false)
then
    $c.eliminate();
    update($c);
    System.out.println("[Nivo 2] ELIMINISAN: Spirit (2+ dokaza isključena)");
end

rule "Eliminate_Spirit_By_Spirit_Box"
    salience 25
when
    $e : CurrentEvidence(ruledOutEvidence contains Evidence.SPIRIT_BOX)
    $c : GhostCandidate(ghostName == "Spirit", eliminated == false)
then
    $c.eliminate();
    update($c);
    System.out.println("[Nivo 2] ELIMINISAN: Spirit (Spirit Box isključen)");
end

