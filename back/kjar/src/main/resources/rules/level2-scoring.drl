rule "Score_Trait_Spirit_LongSmudge"
    salience 12
when
    DerivedTrait(traitName == "Long_Smudge_Timer")
    $c : GhostCandidate(ghostName == "Spirit", eliminated == false)
then
    $c.addScore(1); update($c);
    System.out.println("[Nivo 2] Spirit +1 (Long_Smudge_Timer osobina)");
end

