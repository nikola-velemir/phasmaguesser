rule "Init_Candidate_Goryo"        salience 20 when not GhostCandidate(ghostName == "Goryo")        then insert(new GhostCandidate("Goryo"));        end
rule "Init_Candidate_Myling"       salience 20 when not GhostCandidate(ghostName == "Myling")       then insert(new GhostCandidate("Myling"));       end
