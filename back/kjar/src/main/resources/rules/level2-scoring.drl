// ============================================================
//  BODOVANJE DOKAZA — +1 po svakom poklapanju (max +3)
//  Svaki duh ima 3 svoja dokaza; svaki poklopljeni dokaz = +1
// ============================================================

// --- SPIRIT: EMF5, GHOST_WRITING, SPIRIT_BOX ---
rule "Score_Evidence_Spirit_EMF"       salience 15 when $e:CurrentEvidence(confirmedEvidence contains Evidence.EMF_LEVEL_5)        $c:GhostCandidate(ghostName=="Spirit",eliminated==false)       then $c.addScore(1); update($c); end
rule "Score_Evidence_Spirit_Writing"   salience 15 when $e:CurrentEvidence(confirmedEvidence contains Evidence.GHOST_WRITING)       $c:GhostCandidate(ghostName=="Spirit",eliminated==false)       then $c.addScore(1); update($c); end
rule "Score_Evidence_Spirit_SBox"      salience 15 when $e:CurrentEvidence(confirmedEvidence contains Evidence.SPIRIT_BOX)          $c:GhostCandidate(ghostName=="Spirit",eliminated==false)       then $c.addScore(1); update($c); end

// --- WRAITH: EMF5, UV, SPIRIT_BOX ---
rule "Score_Evidence_Wraith_EMF"       salience 15 when $e:CurrentEvidence(confirmedEvidence contains Evidence.EMF_LEVEL_5)        $c:GhostCandidate(ghostName=="Wraith",eliminated==false)       then $c.addScore(1); update($c); end
rule "Score_Evidence_Wraith_UV"        salience 15 when $e:CurrentEvidence(confirmedEvidence contains Evidence.ULTRAVIOLET)         $c:GhostCandidate(ghostName=="Wraith",eliminated==false)       then $c.addScore(1); update($c); end
rule "Score_Evidence_Wraith_SBox"      salience 15 when $e:CurrentEvidence(confirmedEvidence contains Evidence.SPIRIT_BOX)          $c:GhostCandidate(ghostName=="Wraith",eliminated==false)       then $c.addScore(1); update($c); end

// --- PHANTOM: UV, GHOST_ORB, SPIRIT_BOX ---
rule "Score_Evidence_Phantom_UV"       salience 15 when $e:CurrentEvidence(confirmedEvidence contains Evidence.ULTRAVIOLET)         $c:GhostCandidate(ghostName=="Phantom",eliminated==false)      then $c.addScore(1); update($c); end
rule "Score_Evidence_Phantom_Orb"      salience 15 when $e:CurrentEvidence(confirmedEvidence contains Evidence.GHOST_ORB)           $c:GhostCandidate(ghostName=="Phantom",eliminated==false)      then $c.addScore(1); update($c); end
rule "Score_Evidence_Phantom_SBox"     salience 15 when $e:CurrentEvidence(confirmedEvidence contains Evidence.SPIRIT_BOX)          $c:GhostCandidate(ghostName=="Phantom",eliminated==false)      then $c.addScore(1); update($c); end

