package com.ftn.sbnz.kjar.rules

import com.ftn.sbnz.model.evidence.CurrentEvidence;
import com.ftn.sbnz.model.observations.HuntObservation;
import com.ftn.sbnz.model.traits.DerivedTrait;

// ============================================================
//  NIVO 1 — Izvođenje osobina (Traits) iz HuntObservation
//  salience 30 → uvek se izvršavaju pre Nivoa 2 i 3
//  Svako pravilo ima "not DerivedTrait(...)" guard — nema duplikata
// ============================================================


// ────────────────────────────────────────────────────────────
//  SPIRIT — Long_Smudge_Timer
//  Tamjan traje duže nego normalno (>90s bez lova)
// ────────────────────────────────────────────────────────────
rule "Derive_Long_Smudge_Timer"
    salience 30
when
    HuntObservation(
        incenseUsed == true,
        secondsUntilHuntAfterIncense != null,
        secondsUntilHuntAfterIncense > 90
    )
    not DerivedTrait(traitName == "Long_Smudge_Timer")
then
    insert(new DerivedTrait("Long_Smudge_Timer", "Incense blocked hunt >90s"));
    System.out.println("[Nivo 1] Izvedena osobina: Long_Smudge_Timer");
end


// ────────────────────────────────────────────────────────────
//  WRAITH — No_Salt_Footprints
//  So je ostavljena ali nema otisaka
// ────────────────────────────────────────────────────────────
rule "Derive_No_Salt_Footprints"
    salience 30
when
    HuntObservation(
        saltPlaced == true,
        saltFootprintFound == false
    )
    not DerivedTrait(traitName == "No_Salt_Footprints")
then
    insert(new DerivedTrait("No_Salt_Footprints", "Salt placed but no footprints"));
    System.out.println("[Nivo 1] Izvedena osobina: No_Salt_Footprints");
end


// ────────────────────────────────────────────────────────────
//  PHANTOM — Photo_Disappearance
//  Duh iščezava sa fotografije nakon snimanja
// ────────────────────────────────────────────────────────────
rule "Derive_Photo_Disappearance"
    salience 30
when
    HuntObservation(ghostPhotoTaken == true, ghostDisappearedAfterPhoto == true)
    not DerivedTrait(traitName == "Photo_Disappearance")
then
    insert(new DerivedTrait("Photo_Disappearance", "Ghost disappeared after photo"));
    System.out.println("[Nivo 1] Izvedena osobina: Photo_Disappearance");
end


// ────────────────────────────────────────────────────────────
//  POLTERGEIST — Multi_Object_Throw
//  Baci više predmeta odjednom (≥3 u jednoj interakciji)
// ────────────────────────────────────────────────────────────
rule "Derive_Multi_Object_Throw"
    salience 30
when
    HuntObservation(objectsThrownAtOnce >= 3)
    not DerivedTrait(traitName == "Multi_Object_Throw")
then
    insert(new DerivedTrait("Multi_Object_Throw", "3+ objects thrown simultaneously"));
    System.out.println("[Nivo 1] Izvedena osobina: Multi_Object_Throw");
end


// ────────────────────────────────────────────────────────────
//  BANSHEE — Parabolic_Scream
//  Čuje se jedinstven krik na paraboličnom mikrofonu
// ────────────────────────────────────────────────────────────
rule "Derive_Parabolic_Scream"
    salience 30
when
    HuntObservation(parabolicMicrophoneUsed == true, uniqueScreamHeard == true)
    not DerivedTrait(traitName == "Parabolic_Scream")
then
    insert(new DerivedTrait("Parabolic_Scream", "Unique scream on parabolic mic"));
    System.out.println("[Nivo 1] Izvedena osobina: Parabolic_Scream");
end


// ────────────────────────────────────────────────────────────
//  JINN — Speed_Increase_With_Fuse_Box
//  Duh ubrzava kada je osigurač uključen i igrač je daleko
// ────────────────────────────────────────────────────────────
rule "Derive_Speed_Increase_With_Fuse_Box"
    salience 30
when
    HuntObservation(
        fuseBoxOn == true,
        ghostAcceleratedWithFuseBox == true
