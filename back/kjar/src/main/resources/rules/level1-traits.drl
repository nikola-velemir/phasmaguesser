then
    insert(new DerivedTrait("Quiet_Footsteps_During_Hunt", "Footsteps nearly inaudible during hunt"));
    System.out.println("[Nivo 1] Izvedena osobina: Quiet_Footsteps_During_Hunt");
end


// ────────────────────────────────────────────────────────────
//  ONRYO — Candle_Extinguish_Trigger
//  Lov počinje kada se ugasi sveća (umesto pri niskom sanity-u)
// ────────────────────────────────────────────────────────────
rule "Derive_Candle_Extinguish_Trigger"
    salience 30
when
    HuntObservation(
        candlesExtinguishedBeforeHunt >= 1,
        huntStartedAfterCandleOut == true
    )
    not DerivedTrait(traitName == "Candle_Extinguish_Trigger")
then
    insert(new DerivedTrait("Candle_Extinguish_Trigger", "Hunt started after candle extinguished"));
    System.out.println("[Nivo 1] Izvedena osobina: Candle_Extinguish_Trigger");
end


