    not DerivedTrait(traitName == "Speed_Increase_With_Fuse_Box")
then
    insert(new DerivedTrait("Speed_Increase_With_Fuse_Box", "Ghost sped up with fuse box on"));
    System.out.println("[Nivo 1] Izvedena osobina: Speed_Increase_With_Fuse_Box");
end


// ────────────────────────────────────────────────────────────
//  MARE — Attack_In_Darkness
//  Lov pokrenut u prostoriji bez svetlosti
// ────────────────────────────────────────────────────────────
rule "Derive_Attack_In_Darkness"
    salience 30
when
    HuntObservation(huntStartedInDarkRoom == true)
    not DerivedTrait(traitName == "Attack_In_Darkness")
then
    insert(new DerivedTrait("Attack_In_Darkness", "Hunt started in dark room"));
    System.out.println("[Nivo 1] Izvedena osobina: Attack_In_Darkness");
end


// ────────────────────────────────────────────────────────────
//  REVENANT — High_Hunt_Speed
//  Izuzetno brz tokom lova kada zna gde je igrač
// ────────────────────────────────────────────────────────────
rule "Derive_High_Hunt_Speed"
    salience 30
when
    HuntObservation(highHuntSpeed >= 3)   // m/s; Revenant ≈3 kada zna poziciju
    not DerivedTrait(traitName == "High_Hunt_Speed")
then
    insert(new DerivedTrait("High_Hunt_Speed", "Ghost hunt speed >= 3m/s"));
    System.out.println("[Nivo 1] Izvedena osobina: High_Hunt_Speed");
end


// ────────────────────────────────────────────────────────────
//  SHADE — Shy_In_Presence
//  Drastično manje aktivnosti kada je više igrača u sobi
// ────────────────────────────────────────────────────────────
rule "Derive_Shy_In_Presence"
    salience 30
when
    HuntObservation(
        multiplePlayersPresent == true,
        activityDroppedWithPlayers == true
    )
    not DerivedTrait(traitName == "Shy_In_Presence")
then
    insert(new DerivedTrait("Shy_In_Presence", "Activity dropped with multiple players"));
    System.out.println("[Nivo 1] Izvedena osobina: Shy_In_Presence");
end


// ────────────────────────────────────────────────────────────
//  DEMON — Early_Hunt_And_Low_Cooldown
//  Lov pri visokom sanity-u ILI kratko čekanje između lovova
// ────────────────────────────────────────────────────────────
rule "Derive_Early_Hunt_And_Low_Cooldown"
    salience 30
when
    HuntObservation(
        huntAtHighSanity == true   // lov > 70% sanity
    )
    not DerivedTrait(traitName == "Early_Hunt_And_Low_Cooldown")
then
    insert(new DerivedTrait("Early_Hunt_And_Low_Cooldown", "Hunt triggered at high sanity"));
    System.out.println("[Nivo 1] Izvedena osobina: Early_Hunt_And_Low_Cooldown");
end

rule "Derive_Early_Hunt_Low_Cooldown_Variant"
    salience 30
when
    HuntObservation(
        secondsBetweenHunts != null,
        secondsBetweenHunts < 20    // normalni cooldown je 25s
    )
    not DerivedTrait(traitName == "Early_Hunt_And_Low_Cooldown")
then
    insert(new DerivedTrait("Early_Hunt_And_Low_Cooldown", "Short cooldown between hunts <20s"));
    System.out.println("[Nivo 1] Izvedena osobina: Early_Hunt_And_Low_Cooldown (cooldown)");
end


// ────────────────────────────────────────────────────────────
//  YUREI — Door_Manipulation
//  Zatvori ili baci vrata od sobe i ostane duže u njoj
