then
    insert(new DerivedTrait("Door_Manipulation", "Ghost slammed and locked room door"));
    System.out.println("[Nivo 1] Izvedena osobina: Door_Manipulation");
end


// ────────────────────────────────────────────────────────────
//  ONI — High_Activity_Near_Player
//  Visoka aktivnost kada su igrači prisutni (suprotno od Shade)
