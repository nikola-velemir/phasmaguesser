rule "Derive_Electronics_Speed_Boost"
    salience 30
when
    HuntObservation(
        activeElectronicsNearby == true,
        ghostSpeedIncreasedNearElectronics == true
    )
    not DerivedTrait(traitName == "Electronics_Speed_Boost")
then
    insert(new DerivedTrait("Electronics_Speed_Boost", "Ghost sped up near active electronics"));
    System.out.println("[Nivo 1] Izvedena osobina: Electronics_Speed_Boost");
end


// ────────────────────────────────────────────────────────────
//  OBAKE — Six_Finger_Handprint
//  Ostavlja otisak sa šest prstiju (umesto pet)
// ────────────────────────────────────────────────────────────
rule "Derive_Six_Finger_Handprint"
    salience 30
when
    HuntObservation(sixFingerHandprintFound == true)
    not DerivedTrait(traitName == "Six_Finger_Handprint")
then
    insert(new DerivedTrait("Six_Finger_Handprint", "Six-finger UV handprint found"));
    System.out.println("[Nivo 1] Izvedena osobina: Six_Finger_Handprint");
end


// ────────────────────────────────────────────────────────────
//  THE MIMIC — Copy_Other_Ghosts
//  Ponaša se kao drugi duh (lažni GHOST_ORB kao četvrti dokaz)
// ────────────────────────────────────────────────────────────
rule "Derive_Copy_Other_Ghosts"
    salience 30
when
    $e : CurrentEvidence(confirmedEvidence contains Evidence.GHOST_ORB)
    HuntObservation(behaviorChangedMidInvestigation == true)
    not DerivedTrait(traitName == "Copy_Other_Ghosts")
then
    insert(new DerivedTrait("Copy_Other_Ghosts", "Ghost ORB found + behavior changed (Mimic pattern)"));
    System.out.println("[Nivo 1] Izvedena osobina: Copy_Other_Ghosts");
end


// ────────────────────────────────────────────────────────────
//  MOROI — Curse_And_Speed_Sanity
//  Igrač gubi sanity brže nakon što čuje glas na spirit boxu
// ────────────────────────────────────────────────────────────
rule "Derive_Curse_And_Speed_Sanity"
    salience 30
when
    HuntObservation(
        spiritBoxResponseReceived == true,
        playerSanityDroppedFastAfterResponse == true
    )
    not DerivedTrait(traitName == "Curse_And_Speed_Sanity")
then
    insert(new DerivedTrait("Curse_And_Speed_Sanity", "Fast sanity drain after spirit box response"));
    System.out.println("[Nivo 1] Izvedena osobina: Curse_And_Speed_Sanity");
end


// ────────────────────────────────────────────────────────────
//  DEOGEN — Player_Tracking_And_Close_Slowdown
//  Uvek zna gde je igrač, ali usporava kada mu se približi
// ────────────────────────────────────────────────────────────
rule "Derive_Player_Tracking"
    salience 30
when
    HuntObservation(ghostAlwaysKnewPlayerPosition == true)
    not DerivedTrait(traitName == "Player_Tracking")
then
    insert(new DerivedTrait("Player_Tracking", "Ghost always knows where the player is"));
    System.out.println("[Nivo 1] Izvedena osobina: Player_Tracking");
end
rule "Derive_Close_Slowdown"
    salience 30
when
    HuntObservation(ghostSlowedDownNearPlayer == true)
    not DerivedTrait(traitName == "Close_Slowdown")
then
    insert(new DerivedTrait("Close_Slowdown", "Ghost slows down significantly when close to the player"));
    System.out.println("[Nivo 1] Izvedena osobina: Close_Slowdown");
end

rule "Derive_Aging_Mechanic"
    salience 30
when
    HuntObservation(
        activityDeclinedOverTime == true,
        ghostSpeedDeclinedOverTime == true
    )
    not DerivedTrait(traitName == "Aging_Mechanic")
then
    insert(new DerivedTrait("Aging_Mechanic", "Activity and speed declined over investigation time"));
    System.out.println("[Nivo 1] Izvedena osobina: Aging_Mechanic");
end
