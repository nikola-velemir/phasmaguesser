    not DerivedTrait(traitName == "Temperature_Based_Speed")
then
    insert(new DerivedTrait("Temperature_Based_Speed", "Ghost faster in cold rooms"));
    System.out.println("[Nivo 1] Izvedena osobina: Temperature_Based_Speed");
end


// ────────────────────────────────────────────────────────────
//  GORYO — Camera_Only_DOTS
//  DOTS projektor vidljiv SAMO kroz kameru, ne golim okom
// ────────────────────────────────────────────────────────────
rule "Derive_Camera_Only_DOTS"
    salience 30
when
    HuntObservation(
        dotsVisibleOnCamera == true,
        dotsVisibleToNakedEye == false
