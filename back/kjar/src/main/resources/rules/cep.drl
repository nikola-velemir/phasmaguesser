//     ));
//     System.out.println("[CEP - Onryo] Incense -> hunt in " + gap
//         + "s. Derived: Onryo_Incense_Provokes_Hunt");
// end


// ───────────────────────────────────────────────────────────────────
// Rule O-3 (PENALTY): Incense used → hunt comes 16–90 s later.
//
//  This is normal ghost smudge behaviour — incense delayed the hunt
//  but not as long as Spirit (>90 s). NOT consistent with Onryo.
//  We insert a "penalty" DerivedTrait with a name that has no entry
//  in any Ghost.traits, so no TraitMatch fires — but a profile row
//  can reference it directly via a condition in profiles.drt
//  to subtract points from Onryo.
//
//  Add this profile row to profiles.drt data:
//    ruleName:  Profile_Onryo_Normal_Smudge_Penalty
//    condition: DerivedTrait(traitName == "Onryo_Incense_Normal_Delay")
//    ghostName: Onryo
//    score:     -3
//    logMessage: Onryo -3 (incense delayed hunt normally, not provoked)
// ───────────────────────────────────────────────────────────────────
