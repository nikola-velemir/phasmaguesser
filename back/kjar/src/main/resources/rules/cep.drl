package com.ftn.sbnz.kjar.rules

import com.ftn.sbnz.model.events.CandleExtinguishedEvent;
import com.ftn.sbnz.model.events.HuntStartedEvent;
import com.ftn.sbnz.model.events.IncenceUsedEvent;
import com.ftn.sbnz.model.events.TraitObservedEvent;
import com.ftn.sbnz.model.traits.DerivedTrait;
import com.ftn.sbnz.model.ghosts.Ghost;


// ── CEP type declarations ────────────────────────────────────────────────────
declare CandleExtinguishedEvent
    @role(event)
    @timestamp(timestamp)
    @expires(2m)
end

declare HuntStartedEvent
    @role(event)
    @timestamp(timestamp)
    @expires(5m)
end

declare IncenceUsedEvent
    @role(event)
    @timestamp(timestamp)
    @expires(5m)
end

declare TraitObservedEvent
    @role(event)
    @timestamp(timestamp)
    @expires(10m)
end


// ═══════════════════════════════════════════════════════════════════════════
//  ONRYO
//
//  Hunts after every 3rd candle extinguish within 30s windows.
//  Incense at the threshold provokes rather than prevents a hunt.
// ═══════════════════════════════════════════════════════════════════════════

rule "CEP_Onryo_Triple_Candle_Then_Hunt"
    salience 30
when
    $c1 : CandleExtinguishedEvent()
    $c2 : CandleExtinguishedEvent(
              this != $c1,
              this after[1ms, 30s] $c1
          )
    $c3 : CandleExtinguishedEvent(
              this != $c1,
              this != $c2,
              this after[1ms, 30s] $c2
          )
    $h  : HuntStartedEvent(
              this after[1ms, 30s] $c3
          )
    not DerivedTrait(traitName == "Candle_Extinguish_Trigger")
then
    long gap = ($h.getTimestamp() - $c3.getTimestamp()) / 1000;
    insert(new DerivedTrait(
        "Candle_Extinguish_Trigger",
        "CEP: 3 candles within 30s, hunt " + gap + "s after 3rd"
    ));
    System.out.println("[CEP - Onryo] Triple candle then hunt. Derived: Candle_Extinguish_Trigger");
end


// ═══════════════════════════════════════════════════════════════════════════
//  SMUDGE TIMER — Demon / Regular Ghost / Spirit
//
//  Sequence: HuntStartedEvent → IncenseUsedEvent → next HuntStartedEvent
//  Gap measured between incense and the NEXT hunt after it.
//
//  60–90s   → Demon   (Early_Hunt_And_Low_Cooldown)
//  90–180s  → Regular (Normal_Smudge_Timer)
//  >180s    → Spirit  (Long_Smudge_Timer)
// ═══════════════════════════════════════════════════════════════════════════

rule "CEP_Smudge_Demon_Short_Timer"
    salience 30
when
    $h1 : HuntStartedEvent()
    $i  : IncenceUsedEvent(
              this after[1ms, 300s] $h1
          )
    $h2 : HuntStartedEvent(
              this != $h1,
              this after[60s, 90s] $i
          )
    not DerivedTrait(traitName == "Early_Hunt_And_Low_Cooldown")
then
    long gap = ($h2.getTimestamp() - $i.getTimestamp()) / 1000;
    insert(new DerivedTrait(
        "Early_Hunt_And_Low_Cooldown",
        "CEP: hunt " + gap + "s after incense (60-90s = Demon)"
    ));
    System.out.println("[CEP - Demon] Smudge timer: " + gap + "s. Derived: Early_Hunt_And_Low_Cooldown");
end

rule "CEP_Smudge_Normal_Timer"
    salience 30
when
    $h1 : HuntStartedEvent()
    $i  : IncenceUsedEvent(
              this after[1ms, 300s] $h1
          )
    $h2 : HuntStartedEvent(
              this != $h1,
              this after[90s, 180s] $i
          )
    not DerivedTrait(traitName == "Normal_Smudge_Timer")
then
    long gap = ($h2.getTimestamp() - $i.getTimestamp()) / 1000;
    insert(new DerivedTrait(
        "Normal_Smudge_Timer",
        "CEP: hunt " + gap + "s after incense (90-180s = regular ghost)"
    ));
    System.out.println("[CEP - Regular] Smudge timer: " + gap + "s. Derived: Normal_Smudge_Timer");
end

rule "CEP_Smudge_Spirit_Long_Timer"
    salience 30
when
    $h1 : HuntStartedEvent()
    $i  : IncenceUsedEvent(
              this after[1ms, 300s] $h1
          )
    $h2 : HuntStartedEvent(
              this != $h1,
              this after[180s] $i
          )
    not DerivedTrait(traitName == "Long_Smudge_Timer")
then
    long gap = ($h2.getTimestamp() - $i.getTimestamp()) / 1000;
    insert(new DerivedTrait(
        "Long_Smudge_Timer",
        "CEP: hunt " + gap + "s after incense (>180s = Spirit)"
    ));
    System.out.println("[CEP - Spirit] Smudge timer: " + gap + "s. Derived: Long_Smudge_Timer");
end


// ═══════════════════════════════════════════════════════════════════════════
//  THE MIMIC
//
//  Copies a random ghost every 30–120s. Signal: contradictory behaviours
//  that no single ghost can produce.
//
//  Four independent detection paths — any one is sufficient:
//    M-1a : Two contradictory smudge timers (DerivedTrait × DerivedTrait)
//    M-1b : Two mutually exclusive TraitObservedEvents (event × event)
//    M-1c : A TraitObservedEvent contradicts a smudge-derived trait
//            (event × DerivedTrait) — the gap your scenario hits
//    M-2  : Model visibly changes during a hunt
// ═══════════════════════════════════════════════════════════════════════════

// ── M-1a : Contradictory smudge timers ──────────────────────────────────────
//  Pure DerivedTrait matching — no temporal window needed because the
//  contradiction itself is the signal regardless of when it was observed.

rule "CEP_Mimic_Smudge_Timer_Shift_Short_And_Long"
    salience 35
when
    DerivedTrait(traitName == "Early_Hunt_And_Low_Cooldown")
    DerivedTrait(traitName == "Long_Smudge_Timer")
    not DerivedTrait(traitName == "Copy_Other_Ghosts")
then
    insert(new DerivedTrait(
        "Copy_Other_Ghosts",
        "CEP: Demon smudge (60-90s) AND Spirit smudge (>180s) both observed — Mimic switched"
    ));
    System.out.println("[CEP - Mimic] M-1a Short+Long smudge. Derived: Copy_Other_Ghosts");
end

rule "CEP_Mimic_Smudge_Timer_Shift_Short_And_Normal"
    salience 35
when
    DerivedTrait(traitName == "Early_Hunt_And_Low_Cooldown")
    DerivedTrait(traitName == "Normal_Smudge_Timer")
    not DerivedTrait(traitName == "Copy_Other_Ghosts")
then
    insert(new DerivedTrait(
        "Copy_Other_Ghosts",
        "CEP: Demon smudge (60-90s) AND normal smudge (90-180s) both observed — Mimic switched"
    ));
    System.out.println("[CEP - Mimic] M-1a Short+Normal smudge. Derived: Copy_Other_Ghosts");
end

rule "CEP_Mimic_Smudge_Timer_Shift_Normal_And_Long"
    salience 35
when
    DerivedTrait(traitName == "Normal_Smudge_Timer")
    DerivedTrait(traitName == "Long_Smudge_Timer")
    not DerivedTrait(traitName == "Copy_Other_Ghosts")
then
    insert(new DerivedTrait(
        "Copy_Other_Ghosts",
        "CEP: Normal smudge (90-180s) AND Spirit smudge (>180s) both observed — Mimic switched"
    ));
    System.out.println("[CEP - Mimic] M-1a Normal+Long smudge. Derived: Copy_Other_Ghosts");
end


// ── M-1b : Two mutually exclusive TraitObservedEvents ───────────────────────
//  Window extended to 5m — Mimic switches every 30-120s so two player
//  observations can easily be several minutes apart within one investigation.
//  The not Ghost(...) guard ensures no single real ghost owns both traits.

rule "CEP_Mimic_Behaviour_Shift"
    salience 30
when
    $t1 : TraitObservedEvent($trait1 : traitName)
    $t2 : TraitObservedEvent(
              this != $t1,
              traitName != $trait1,
              this after[1ms, 5m] $t1
          )
    Ghost(hasTrait($trait1))
    Ghost(hasTrait($t2.getTraitName()))
    not Ghost(hasTrait($trait1) && hasTrait($t2.getTraitName()))
    not DerivedTrait(traitName == "Copy_Other_Ghosts")
then
    insert(new DerivedTrait(
        "Copy_Other_Ghosts",
        "CEP: '" + $trait1 + "' then '" + $t2.getTraitName() + "' within 5m — mutually exclusive traits"
    ));
    System.out.println("[CEP - Mimic] M-1b Behaviour shift: '" + $trait1
        + "' -> '" + $t2.getTraitName() + "'. Derived: Copy_Other_Ghosts");
end


// ── M-1c : TraitObservedEvent contradicts a smudge-derived trait ─────────────
//  This is the gap your scenario hits:
//    Player observes Temperature_Based_Speed (TraitObservedEvent)
//    CEP later derives Early_Hunt_And_Low_Cooldown (Demon smudge timer)
//    No single ghost has both — Mimic is copying two different ghosts.
//
//  We enumerate the three smudge DerivedTraits against trait observations
//  that belong to ghosts which CANNOT have that smudge behaviour.
//  "Cannot have" = no Ghost fact exists that owns both the observed trait
//  AND the smudge trait — same guard as M-1b but crossing fact types.
//
//  Note: smudge DerivedTraits are not TraitObservedEvents so `after` cannot
//  be used. The contradiction itself is the temporal signal — order and
//  timing don't matter, only that both facts coexist in the session.

rule "CEP_Mimic_Trait_Contradicts_Short_Smudge"
    salience 35
when
    $t  : TraitObservedEvent($traitName : traitName)
    DerivedTrait(traitName == "Early_Hunt_And_Low_Cooldown")
    Ghost(hasTrait($traitName))
    not Ghost(hasTrait($traitName) && hasTrait("Early_Hunt_And_Low_Cooldown"))
    not DerivedTrait(traitName == "Copy_Other_Ghosts")
then
    insert(new DerivedTrait(
        "Copy_Other_Ghosts",
        "CEP: observed '" + $traitName + "' but Demon smudge timer also seen — Mimic switched"
    ));
    System.out.println("[CEP - Mimic] M-1c '" + $traitName
        + "' contradicts Early_Hunt_And_Low_Cooldown. Derived: Copy_Other_Ghosts");
end

rule "CEP_Mimic_Trait_Contradicts_Normal_Smudge"
    salience 35
when
    $t  : TraitObservedEvent($traitName : traitName)
    DerivedTrait(traitName == "Normal_Smudge_Timer")
    Ghost(hasTrait($traitName))
    not Ghost(hasTrait($traitName) && hasTrait("Normal_Smudge_Timer"))
    not DerivedTrait(traitName == "Copy_Other_Ghosts")
then
    insert(new DerivedTrait(
        "Copy_Other_Ghosts",
        "CEP: observed '" + $traitName + "' but normal smudge timer also seen — Mimic switched"
    ));
    System.out.println("[CEP - Mimic] M-1c '" + $traitName
        + "' contradicts Normal_Smudge_Timer. Derived: Copy_Other_Ghosts");
end

rule "CEP_Mimic_Trait_Contradicts_Long_Smudge"
    salience 35
when
    $t  : TraitObservedEvent($traitName : traitName)
    DerivedTrait(traitName == "Long_Smudge_Timer")
    Ghost(hasTrait($traitName))
    not Ghost(hasTrait($traitName) && hasTrait("Long_Smudge_Timer"))
    not DerivedTrait(traitName == "Copy_Other_Ghosts")
then
    insert(new DerivedTrait(
        "Copy_Other_Ghosts",
        "CEP: observed '" + $traitName + "' but Spirit smudge timer also seen — Mimic switched"
    ));
    System.out.println("[CEP - Mimic] M-1c '" + $traitName
        + "' contradicts Long_Smudge_Timer. Derived: Copy_Other_Ghosts");
end

rule "CEP_Mimic_Trait_Contradicts_Candle_Trigger"
    salience 35
when
    $t  : TraitObservedEvent($traitName : traitName)
    DerivedTrait(traitName == "Candle_Extinguish_Trigger")
    Ghost(hasTrait($traitName))
    not Ghost(hasTrait($traitName) && hasTrait("Candle_Extinguish_Trigger"))
    not DerivedTrait(traitName == "Copy_Other_Ghosts")
then
    insert(new DerivedTrait(
        "Copy_Other_Ghosts",
        "CEP: observed '" + $traitName + "' but Onryo candle trigger also seen — Mimic switched"
    ));
    System.out.println("[CEP - Mimic] M-1c '" + $traitName
        + "' contradicts Candle_Extinguish_Trigger. Derived: Copy_Other_Ghosts");
end


// ── M-2 : Model visibly changes during a hunt ───────────────────────────────

rule "CEP_Mimic_Model_Changing_During_Hunt"
    salience 30
when
    $h : HuntStartedEvent()
    $t : TraitObservedEvent(
             traitName == "Model_Changing_During_Hunt",
             this after[1ms, 120s] $h
         )
    not DerivedTrait(traitName == "Model_Changing_During_Hunt")
then
    long gap = ($t.getTimestamp() - $h.getTimestamp()) / 1000;
    insert(new DerivedTrait(
        "Model_Changing_During_Hunt",
        "CEP: model change observed " + gap + "s into hunt"
    ));
    System.out.println("[CEP - Mimic] M-2 Model change " + gap + "s after hunt. Derived: Model_Changing_During_Hunt");
end
