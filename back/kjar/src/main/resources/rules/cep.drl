package com.ftn.sbnz.kjar.rules

import com.ftn.sbnz.model.events.CandleExtinguishedEvent;
import com.ftn.sbnz.model.events.HuntStartedEvent;
import com.ftn.sbnz.model.events.IncenceUsedEvent;
import com.ftn.sbnz.model.events.TraitObservedEvent;
import com.ftn.sbnz.model.traits.DerivedTrait;



// ── CEP type declarations ────────────────────────────────────────────
declare CandleExtinguishedEvent
    @role(event)
    @timestamp(timestamp)
    @expires(2m)
end

declare HuntStartedEvent
    @role(event)
    @timestamp(timestamp)
    @expires(5m)
end

declare IncenceUsedEvent
    @role(event)
    @timestamp(timestamp)
    @expires(5m)
end

declare TraitObservedEvent
    @role(event)
    @timestamp(timestamp)
    @expires(10m)
end


// ═══════════════════════════════════════════════════════════════════
//  ONRYO
//
//  Game mechanic:
//    - Extinguishes candles instead of hunting normally.
//    - Hunts after every 3rd candle extinguish (counter resets on hunt).
//    - Incense resets the counter to 0 (protects players normally).
//    - BUT: if incense is used at exactly the threshold moment (3rd
//      candle just blown out), the Onryo hunts immediately instead
//      of waiting — incense provokes rather than prevents.
// ═══════════════════════════════════════════════════════════════════

// ───────────────────────────────────────────────────────────────────
// Rule O-1 : 3 candles extinguished within 30 s, then hunt within 30 s
//            of the third candle.
//
//  Derives "Candle_Extinguish_Trigger" — exact trait name in
//  ghost-identities.xls (Onryo row) and profiles.xls
//  (Profile_Onryo_Candle_Trigger_DEFINITIVE, +5).
// ───────────────────────────────────────────────────────────────────
rule "CEP_Onryo_Triple_Candle_Then_Hunt"
    salience 30
when
    $c1 : CandleExtinguishedEvent()
    $c2 : CandleExtinguishedEvent(
              this != $c1,
              this after[1ms, 30s] $c1
          )
    $c3 : CandleExtinguishedEvent(
              this != $c1,
              this != $c2,
              this after[1ms, 30s] $c2
          )
    $h  : HuntStartedEvent(
              this after[1ms, 30s] $c3
          )
    not DerivedTrait(traitName == "Candle_Extinguish_Trigger")
then
    long gap = ($h.getTimestamp() - $c3.getTimestamp()) / 1000;
    insert(new DerivedTrait(
        "Candle_Extinguish_Trigger",
        "CEP: 3 candles within 30s, hunt " + gap + "s after 3rd"
    ));
end
// ───────────────────────────────────────────────────────────────────
// Rule O-2 : Incense used → hunt starts within 15 s.
//
//  The Onryo is the ONLY ghost where incense can cause a near-immediate
//  hunt. All others gain ≥20 s immunity (Spirit gets >90 s).
//  Threshold 15 s covers real game timing (typically 1–5 s) with
//  comfortable headroom for input lag.
//
//  Derives "Onryo_Incense_Provokes_Hunt".
//  Add this trait to Onryo in your data loader + profiles_updated.xlsx.
// ───────────────────────────────────────────────────────────────────
