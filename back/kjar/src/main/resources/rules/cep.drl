// ═══════════════════════════════════════════════════════════════════
//  THE MIMIC
//
//  Game mechanic:
//    - Copies a random ghost type every 30–120 s.
//    - Uses that ghost's speed, hunt behaviour, and special ability.
//    - Does NOT copy that ghost's evidence set.
//    - Always shows Ghost Orb as a fake 4th evidence
//      (already scored: Profile_Mimic_Ghost_Orb_MEDIUM +2).
//    - Model visually changes during hunts (Model_Changing_During_Hunt).
//
//  CEP signal: players observe traits belonging to two DIFFERENT ghost
//  types in the same investigation window.
// ═══════════════════════════════════════════════════════════════════

// ───────────────────────────────────────────────────────────────────
// Rule M-1 : Two DIFFERENT trait names observed within 3 minutes.
//
//  TraitObservedEvent.traitName must be one of the Trait column values
//  from ghost-identities.xls: "High_Hunt_Speed", "Voice_Sensitivity",
//  "Candle_Extinguish_Trigger", "Attack_In_Darkness", etc.
//  Fire this event from your backend when players confirm a behaviour.
//
//  Window: 3 min. The Mimic switches every 30–120 s, so two different
//  traits are nearly guaranteed within 3 min for a real Mimic.
//  No normal ghost ever produces two different trait types.
//
//  Derives "Copy_Other_Ghosts" — exact trait name for The Mimic in
//  ghost-identities.xls. Profile_Mimic_Copy_Behavior_HIGH scores +3.
// ───────────────────────────────────────────────────────────────────
rule "CEP_Mimic_Behaviour_Shift"
    salience 30
when
    $t1 : TraitObservedEvent($trait1 : traitName)
    $t2 : TraitObservedEvent(
              this != $t1,
              traitName != $trait1,
              this after[1ms, 3m] $t1
          )
    not DerivedTrait(traitName == "Copy_Other_Ghosts")
then
    insert(new DerivedTrait(
        "Copy_Other_Ghosts",
        "CEP: '" + $trait1 + "' then '" + $t2.getTraitName() + "' within 3 min"
    ));
    System.out.println("[CEP - Mimic] Behaviour shift: '" + $trait1
        + "' -> '" + $t2.getTraitName() + "'. Derived: Copy_Other_Ghosts");
end


// ───────────────────────────────────────────────────────────────────
// Rule M-2 : Model visibly changed during a hunt (within 120 s).
//
//  Players fire TraitObservedEvent(traitName="Model_Changing_During_Hunt")
//  when they see the ghost's appearance change mid-hunt.
//
//  "Model_Changing_During_Hunt" is already in traits.xls with a
//  HuntObservation-based condition (modelChangingDuringHunt == true).
//  This CEP rule catches the same trait from the event stream instead,
//  useful when HuntObservation is not populated but the event is fired.
//
//  The `not DerivedTrait` guard prevents double-insertion if the
//  traits.drt rule already derived it from HuntObservation.
// ───────────────────────────────────────────────────────────────────
// ═══════════════════════════════════════════════════════════════════
//  SMUDGE TIMER — Demon / Regular Ghost / Spirit
//
//  Sequence: HuntStartedEvent → IncenseUsedEvent → next HuntStartedEvent
//  We measure the gap between incense and the NEXT hunt after it.
//
//  60s – 90s  → Demon        (Short_Smudge_Timer)
//  90s – 180s → Regular      (Normal_Smudge_Timer)
//  >180s      → Spirit       (Long_Smudge_Timer)
//
//  $h1 is the hunt BEFORE incense (confirms incense was used mid-hunt
//  or right after). $i must come after $h1. $h2 is the next hunt after
//  incense. The gap that matters is $h2 - $i.
// ═══════════════════════════════════════════════════════════════════

// ───────────────────────────────────────────────────────────────────
// Rule S-1 : Hunt after incense in 60–90 s → Demon
// ───────────────────────────────────────────────────────────────────
rule "CEP_Smudge_Demon_Short_Timer"
    salience 30
when
    $h1 : HuntStartedEvent()
    $i  : IncenceUsedEvent(
              this after[1ms, 300s] $h1
          )
    $h2 : HuntStartedEvent(
              this != $h1,
              this after[60s, 90s] $i
          )
    not DerivedTrait(traitName == "Early_Hunt_And_Low_Cooldown")
then
    long gap = ($h2.getTimestamp() - $i.getTimestamp()) / 1000;
    insert(new DerivedTrait(
        "Early_Hunt_And_Low_Cooldown",
        "CEP: hunt " + gap + "s after incense (60-90s = Demon)"
    ));
    System.out.println("[CEP - Demon] Smudge timer: hunt in " + gap
        + "s after incense. Derived: Early_Hunt_And_Low_Cooldown");
end


// ───────────────────────────────────────────────────────────────────
// Rule S-2 : Hunt after incense in 90–180 s → Regular ghost
// ───────────────────────────────────────────────────────────────────
rule "CEP_Smudge_Normal_Timer"
    salience 30
when
    $h1 : HuntStartedEvent()
    $i  : IncenceUsedEvent(
              this after[1ms, 300s] $h1
          )
    $h2 : HuntStartedEvent(
              this != $h1,
              this after[90s, 180s] $i
          )
    not DerivedTrait(traitName == "Normal_Smudge_Timer")
then
    long gap = ($h2.getTimestamp() - $i.getTimestamp()) / 1000;
    insert(new DerivedTrait(
        "Normal_Smudge_Timer",
        "CEP: hunt " + gap + "s after incense (90-180s = regular ghost)"
    ));
    System.out.println("[CEP - Regular] Smudge timer: hunt in " + gap
        + "s after incense. Derived: Normal_Smudge_Timer");
end


// ───────────────────────────────────────────────────────────────────
// Rule S-3 : Hunt after incense after 180 s → Spirit
// ───────────────────────────────────────────────────────────────────
rule "CEP_Smudge_Spirit_Long_Timer"
    salience 30 
when
    $h1 : HuntStartedEvent()
    $i  : IncenceUsedEvent(
              this after[1ms, 300s] $h1
          )
    $h2 : HuntStartedEvent(
              this != $h1,
              this after[180s] $i
          )
    not DerivedTrait(traitName == "Long_Smudge_Timer")
then
    long gap = ($h2.getTimestamp() - $i.getTimestamp()) / 1000;
    insert(new DerivedTrait(
        "Long_Smudge_Timer",
        "CEP: hunt " + gap + "s after incense (>180s = Spirit)"
    ));
    System.out.println("[CEP - Spirit] Smudge timer: hunt in " + gap
        + "s after incense. Derived: Long_Smudge_Timer");
end


rule "CEP_Mimic_Model_Changing_During_Hunt"
    salience 30
when
    $h : HuntStartedEvent()
    $t : TraitObservedEvent(
             traitName == "Model_Changing_During_Hunt",
             this after[1ms, 120s] $h
         )
    not DerivedTrait(traitName == "Model_Changing_During_Hunt")
then
    long gap = ($t.getTimestamp() - $h.getTimestamp()) / 1000;
    insert(new DerivedTrait(
        "Model_Changing_During_Hunt",
        "CEP: model change observed " + gap + "s into hunt"
    ));
    System.out.println("[CEP - Mimic] Model change " + gap
        + "s after hunt start. Derived: Model_Changing_During_Hunt");
end