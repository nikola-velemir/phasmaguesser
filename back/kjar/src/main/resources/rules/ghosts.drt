template header
ghostName

package com.ftn.sbnz.rules.templates

import com.ftn.sbnz.model.ghosts.Ghost
import com.ftn.sbnz.model.ghosts.GhostCandidate
import com.ftn.sbnz.model.evidence.Evidence
import com.ftn.sbnz.model.evidence.CurrentEvidence
import com.ftn.sbnz.model.ghosts.GhostEliminated


dialect "java"

template "ghost-identification"

rule "Eliminate_Evidence_@{ghostName}"
    salience 100
    no-loop true
when
    $g : Ghost(
        name == "@{ghostName}",
        $evidences : evidences
    )
    $c : GhostCandidate(
        ghostName == "@{ghostName}",
        eliminated == false
    )
    $input : CurrentEvidence()
    exists Evidence(!$evidences.contains(this)) from $input.confirmedEvidence
    not GhostEliminated(ghostName == "@{ghostName}")   // idempotent
then
    insert(new GhostEliminated("@{ghostName}", "evidence mismatch"));
    System.out.println("[ELIMINATION] @{ghostName} eliminated.");
end

end template