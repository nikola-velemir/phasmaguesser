template header
ghostName

package com.ftn.sbnz.rules.templates

import com.ftn.sbnz.model.ghosts.Ghost
import com.ftn.sbnz.model.ghosts.GhostCandidate
import com.ftn.sbnz.model.evidence.Evidence
import com.ftn.sbnz.model.evidence.CurrentEvidence

dialect "java"

template "ghost-identification"

rule "Eliminate_Evidence_@{ghostName}"
    salience 100
    no-loop true
when
    $g : Ghost(
        name == "@{ghostName}",
        $ge1 : evidence1,
        $ge2 : evidence2,
        $ge3 : evidence3
    )

    $c : GhostCandidate(
        ghostName == "@{ghostName}",
        eliminated == false
    )

    $input : CurrentEvidence()

    exists Evidence(
        this != $ge1,
        this != $ge2,
        this != $ge3
    ) from $input.confirmedEvidence

then
    $c.eliminate();
    update($c);

    System.out.println("[ELIMINATION] Ghost @{ghostName} eliminated due to evidence.");
end

end template