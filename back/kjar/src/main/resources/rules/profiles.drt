template header
ruleName
condition
ghostName
score
logMessage

package com.ftn.sbnz.kjar.rules

import com.ftn.sbnz.model.evidence.CurrentEvidence;
import com.ftn.sbnz.model.evidence.Evidence;
import com.ftn.sbnz.model.observations.HuntObservation;
import com.ftn.sbnz.model.ghosts.GhostCandidate;
import com.ftn.sbnz.model.traits.DerivedTrait;

dialect "java"

template "generic-profile-scoring"

rule "@{ruleName}"
    salience 5
when
    // Šablon ovde direktno ubacuje uslov iz Excela
    @{condition}
    
    $c : GhostCandidate(
        ghostName == "@{ghostName}",
        eliminated == false,
        appliedRules not contains "@{ruleName}"
    )
then
    $c.addScore(@{score});
    $c.applyRule("@{ruleName}");
    update($c);
    System.out.println("[Nivo 3] @{logMessage}");
end

end template