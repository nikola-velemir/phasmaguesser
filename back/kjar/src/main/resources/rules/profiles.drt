template header
ruleName
condition
ghostName
score
logMessage

package com.ftn.sbnz.kjar.rules

import com.ftn.sbnz.model.evidence.CurrentEvidence;
import com.ftn.sbnz.model.evidence.Evidence;
import com.ftn.sbnz.model.observations.HuntObservation;
import com.ftn.sbnz.model.ghosts.GhostCandidate;
import com.ftn.sbnz.model.traits.DerivedTrait;
import com.ftn.sbnz.model.ghosts.GhostEliminated;

dialect "java"

template "generic-profile-scoring"

rule "@{ruleName}"
    salience 5
when
    @{condition}
    Ghost(name == "@{ghostName}")
    not GhostEliminated(ghostName == "@{ghostName}")
    not ProfileMatch(ghostName == "@{ghostName}", ruleName == "@{ruleName}")
then
    insert(new ProfileMatch("@{ghostName}", "@{ruleName}", @{score}));
    System.out.println("[LEVEL 3 - Scoring] @{logMessage}");
end

end template