package com.ftn.sbnz.kjar.rules

import com.ftn.sbnz.model.evidence.CurrentEvidence;
import com.ftn.sbnz.model.evidence.Evidence;
import com.ftn.sbnz.model.ghosts.GhostCandidate;
import com.ftn.sbnz.model.ghosts.DerivedTrait;

// ============================================================
//  NIVO 3 — Profilno poklapanje (kombinovane osobine + dokazi)
//
//  Ovaj nivo traži kombinacije osobina koje zajedno čine
//  prepoznatljiv profil pojedinog duha.
//  Može preokrenuti rang iz Nivoa 2.
//
//  Težine:
//    LOW       (+1)  — moguće ali nije karakteristično
//    MEDIUM    (+2)  — čini duha verovatnim
//    HIGH      (+3)  — karakteristično, snažno ukazuje
//    DEFINITIVE(+5)  — jednoznačno identifikuje duha
//
//  salience 5 → uvek se izvršavaju poslednji
// ============================================================


// ════════════════════════════════════════════════════════════
//  SPIRIT
// ════════════════════════════════════════════════════════════

// HIGH: Tamjan blokira duh duže od 90s + sva 3 dokaza prisutna
rule "Profile_Spirit_HIGH_FullEvidenceAndSmudge"
    salience 5
when
    DerivedTrait(traitName == "Long_Smudge_Timer")
    $e : CurrentEvidence(
        confirmedEvidence contains Evidence.EMF_LEVEL_5,
        confirmedEvidence contains Evidence.GHOST_WRITING,
        confirmedEvidence contains Evidence.SPIRIT_BOX
    )
    $c : GhostCandidate(ghostName == "Spirit", eliminated == false)
then
    $c.addScore(3);
    $c.setProfileWeight("HIGH");
    update($c);
    System.out.println("[Nivo 3] Spirit profil HIGH (+3) — Svi dokazi + Long Smudge");
end

// MEDIUM: Long_Smudge_Timer potvrđen bez svih dokaza
rule "Profile_Spirit_MEDIUM_SmudgeOnly"
    salience 5
when
    DerivedTrait(traitName == "Long_Smudge_Timer")
    $c : GhostCandidate(ghostName == "Spirit", eliminated == false, score < 4)
then
    $c.addScore(2);
    $c.setProfileWeight("MEDIUM");
    update($c);
    System.out.println("[Nivo 3] Spirit profil MEDIUM (+2) — Long Smudge bez svih dokaza");
end


