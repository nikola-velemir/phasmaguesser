package com.ftn.sbnz.kjar.rules

import com.ftn.sbnz.model.evidence.CurrentEvidence;
import com.ftn.sbnz.model.evidence.Evidence;
import com.ftn.sbnz.model.observations.HuntObservation;
import com.ftn.sbnz.model.ghosts.Ghost;
import com.ftn.sbnz.model.ghosts.GhostCandidate;
import com.ftn.sbnz.model.traits.DerivedTrait;

// ============================================================================
//  NIVO 3 — Profilno poklapanje sa eksplicitnim težinama
//
//  Težinski sistem:
//    LOW        → +1  (osobina moguća, ali nije karakteristična)
//    MEDIUM     → +2  (osobina čini duha verovatnim kandidatom)
//    HIGH       → +3  (karakteristična osobina, snažno ukazuje na duha)
//    DEFINITIVE → +5  (kombinacija osobina jednoznačno identifikuje duha)
//
//  Kazne (negativni skor) se dodaju kada duh pokazuje ponašanje koje
//  direktno protivreči profilu.
//
//  salience 5 → uvek posle Nivoa 1 (30) i Nivoa 2 (20)
// ============================================================================


// ============================================================================
//  SPIRIT
// ============================================================================

// HIGH: tamjan ga blokira duže nego sve ostale duhove — karakteristično
rule "Profile_Spirit_Long_Smudge_Timer_HIGH"
    salience 5
when
    DerivedTrait(traitName == "Long_Smudge_Timer")
    $c : GhostCandidate(
        ghostName == "Spirit",
        eliminated == false,
        appliedRules not contains "Profile_Spirit_Long_Smudge_Timer_HIGH"
    )
then
    $c.addScore(3);
    $c.applyRule("Profile_Spirit_Long_Smudge_Timer_HIGH");
    update($c);
    System.out.println("[Nivo 3 - HIGH] Spirit +3 (Long_Smudge_Timer)");
end


