end

// HIGH: samo praćenje bez usporavanja — moguće ali manje specifično
rule "Profile_Deogen_Player_Tracking_Only_HIGH"
    salience 5
when
    DerivedTrait(traitName == "Player_Tracking")
    not DerivedTrait(traitName == "Close_Slowdown")
    $c : GhostCandidate(
        ghostName == "Deogen",
        eliminated == false,
        appliedRules not contains "Profile_Deogen_Player_Tracking_Only_HIGH"
    )
then
    $c.addScore(3);
