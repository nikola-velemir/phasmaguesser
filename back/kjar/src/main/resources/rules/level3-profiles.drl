// KAZNA: lov nije pokrenut u mraku — direktno protivreči Mare profilu
// Koristimo samo huntStartedInDarkRoom koje postoji u modelu
rule "Profile_Penalty_Mare_Hunt_Not_In_Dark"
    salience 5
when
    HuntObservation(huntStartedInDarkRoom == false)
    $c : GhostCandidate(
        ghostName == "Mare",
        eliminated == false,
        appliedRules not contains "Profile_Penalty_Mare_Hunt_Not_In_Dark"
    )
then
    $c.addScore(-3);
    $c.applyRule("Profile_Penalty_Mare_Hunt_Not_In_Dark");
    update($c);
    System.out.println("[Nivo 3 - KAZNA] Mare -3 (lov nije pokrenut u mraku)");
end

rule "Profile_Contradiction_Wraith_Footprint_Found"
    salience 5
when
    HuntObservation(saltFootprintFound == true)
    $c : GhostCandidate(
        ghostName == "Wraith",
        eliminated == false,
        appliedRules not contains "Profile_Contradiction_Wraith_Footprint_Found"
    )
then
    $c.addScore(-20); 

    
    $c.applyRule("Profile_Contradiction_Wraith_Footprint_Found");
    update($c);
    System.out.println("[Nivo 3 - PROTIVREČNOST] Wraith kažnjen sa -20 jer su pronađeni otisci u soli.");
end

