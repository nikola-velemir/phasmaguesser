when
    DerivedTrait(traitName == "Copy_Other_Ghosts")
    $e : CurrentEvidence(
        confirmedEvidence contains Evidence.ULTRAVIOLET,
        confirmedEvidence contains Evidence.FREEZING_TEMPERATURES,
        confirmedEvidence contains Evidence.SPIRIT_BOX,
        confirmedEvidence contains Evidence.GHOST_ORB   // lažni 4. dokaz
    )
    $c : GhostCandidate(ghostName == "The Mimic", eliminated == false)
then
    $c.addScore(5);
    $c.setProfileWeight("DEFINITIVE");
    update($c);
