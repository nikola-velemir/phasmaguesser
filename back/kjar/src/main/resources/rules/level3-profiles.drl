// ════════════════════════════════════════════════════════════
//  CROSS-GHOST NEGATIVE BODOVANJE
//  Osobina koja ISKLJUČUJE određene duhove daje penalty
// ════════════════════════════════════════════════════════════

// Ako se vidi DOTS golim okom → Goryo je već eliminisan,
// ali Shade (koji je sramežljiv) je malo verovatno uz visoku aktivnost
rule "Penalty_Shade_HighActivity"
    salience 5
when
    DerivedTrait(traitName == "High_Activity_Near_Player")
    $c : GhostCandidate(ghostName == "Shade", eliminated == false)
then
    $c.addScore(-2);
    update($c);
    System.out.println("[Nivo 3] Shade -2 (High Activity nije karakteristično za Shade)");
end

// Yokai lovi samo uz glasove — ako nije lovio uz glasove, nije Yokai
rule "Penalty_Yokai_NoVoiceTrigger"
    salience 5
when
    not DerivedTrait(traitName == "Voice_Sensitivity")
    $c : GhostCandidate(ghostName == "Yokai", eliminated == false)
then
    $c.addScore(-1);
    update($c);
    System.out.println("[Nivo 3] Yokai -1 (Voice Sensitivity nije primećena)");
end

// Jinn ne može smanjiti brzinu uz uključen osigurač — ako je duh spor uz osigurač, nije Jinn
rule "Penalty_Jinn_SlowWithFuseBox"
    salience 5
when
    HuntObservation(fuseBoxOn == true, ghostAcceleratedWithFuseBox == false)
    $c : GhostCandidate(ghostName == "Jinn", eliminated == false)
then
    $c.addScore(-2);
    update($c);
    System.out.println("[Nivo 3] Jinn -2 (Nije ubrzao uz uključen osigurač)");
end

// Oni nikada ne pravi magle od disanja — ako je viđen dah, Oni je malo verovatno
// (ovaj trait ostaje LOW jer nije definitivan)
rule "Penalty_Oni_BreathVisible"
    salience 5
when
    HuntObservation(breathVisibleInCold == false, freezingTemperatures == true)
    $c : GhostCandidate(ghostName == "Oni", eliminated == false)
then
    // Oni nema breath puff — odsustvo je korisna potvrda, ali ne kazna
    // Ovo pravilo ne menja skor (LOW signal)
    System.out.println("[Nivo 3] Oni LOW signal — nema vidljivog daha (karakteristično za Oni)");
end
