// ============================================================================
//  THE MIMIC
// ============================================================================

// MEDIUM: Ghost Orb potvrđen — moguć ali ne jedinstven za Mimic
rule "Profile_Mimic_Ghost_Orb_MEDIUM"
    salience 5
when
    $input : CurrentEvidence(confirmedEvidence contains Evidence.GHOST_ORB)
    $c : GhostCandidate(
        ghostName == "The Mimic",
        eliminated == false,
        appliedRules not contains "Profile_Mimic_Ghost_Orb_MEDIUM"
    )
then
    $c.addScore(2);
    $c.applyRule("Profile_Mimic_Ghost_Orb_MEDIUM");
    update($c);
    System.out.println("[Nivo 3 - MEDIUM] The Mimic +2 (Ghost_Orb potvrđen)");
end

// HIGH: Ghost Orb + promena ponašanja — kombinacija karakteristična za Mimic
rule "Profile_Mimic_Copy_Behavior_HIGH"
    salience 5
when
    DerivedTrait(traitName == "Copy_Other_Ghosts")
    $c : GhostCandidate(
        ghostName == "The Mimic",
        eliminated == false,
        appliedRules not contains "Profile_Mimic_Copy_Behavior_HIGH"
    )
then
    $c.addScore(3);
    $c.applyRule("Profile_Mimic_Copy_Behavior_HIGH");
    update($c);
    System.out.println("[Nivo 3 - HIGH] The Mimic +3 (Copy_Other_Ghosts)");
end


