// DEFINITIVE: praćenje + usporavanje pri dolasku — kombinacija jednoznačna za Deogen
rule "Profile_Deogen_Tracking_And_Slowdown_DEFINITIVE"
    salience 5
when
    DerivedTrait(traitName == "Player_Tracking")
    DerivedTrait(traitName == "Close_Slowdown")
    $c : GhostCandidate(
        ghostName == "Deogen",
