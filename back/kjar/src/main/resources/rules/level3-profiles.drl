    salience 5
when
    DerivedTrait(traitName == "Six_Finger_Handprint")
    $e : CurrentEvidence(
        confirmedEvidence contains Evidence.EMF_LEVEL_5,
        confirmedEvidence contains Evidence.ULTRAVIOLET,
        confirmedEvidence contains Evidence.GHOST_ORB
    )
