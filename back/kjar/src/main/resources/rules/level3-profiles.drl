    salience 5
when
    DerivedTrait(traitName == "Electronics_Speed_Boost")
    $c : GhostCandidate(ghostName == "Raiju", eliminated == false, score < 6)
then
    $c.addScore(3);
    $c.setProfileWeight("HIGH");
    update($c);
    System.out.println("[Nivo 3] Raiju profil HIGH (+3) — Electronics Speed Boost");
end


