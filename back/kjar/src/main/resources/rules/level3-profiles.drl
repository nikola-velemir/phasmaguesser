// ============================================================================
//  POLTERGEIST
// ============================================================================

// HIGH: bacanje više predmeta odjednom — karakteristično
rule "Profile_Poltergeist_Multi_Object_Throw_HIGH"
    salience 5
when
    DerivedTrait(traitName == "Multi_Object_Throw")
    $c : GhostCandidate(
        ghostName == "Poltergeist",
        eliminated == false,
        appliedRules not contains "Profile_Poltergeist_Multi_Object_Throw_HIGH"
    )
then
    $c.addScore(3);
    $c.applyRule("Profile_Poltergeist_Multi_Object_Throw_HIGH");
    update($c);
    System.out.println("[Nivo 3 - HIGH] Poltergeist +3 (Multi_Object_Throw)");
end

// KAZNA: nema bacanja predmeta — direktno protivreči Poltergeist profilu
rule "Profile_Penalty_Poltergeist_No_Throwing"
    salience 5
when
    HuntObservation(objectsThrownAtOnce == 0)
    $c : GhostCandidate(
        ghostName == "Poltergeist",
        eliminated == false,
        appliedRules not contains "Profile_Penalty_Poltergeist_No_Throwing"
    )
then
    $c.addScore(-2);
    $c.applyRule("Profile_Penalty_Poltergeist_No_Throwing");
    update($c);
    System.out.println("[Nivo 3 - KAZNA] Poltergeist -2 (nema bacanja predmeta)");
end


