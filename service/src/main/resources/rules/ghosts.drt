template header
ghostName
evidence1
evidence2
evidence3
trait

package com.ftn.sbnz.kjar.rules

import com.ftn.sbnz.model.ghosts.Ghost;
import com.ftn.sbnz.model.ghosts.Evidence;
import com.ftn.sbnz.model.ghosts.CurrentEvidence;

template "ghost-indentification"

rule "Indetify_@{ghostName}"
when
    $g: Ghost(name == "@{ghostName}", $ge1: evidence1, $ge2: evidence2, $ge3: evidence3)

    $input : CurrentEvidence(
        (evidence1 == $ge1 || evidence1 == $ge2 || evidence1 == $ge3),
        (evidence2 == $ge1 || evidence2 == $ge2 || evidence2 == $ge3),
        (evidence3 == $ge1 || evidence3 == $ge2 || evidence3 == $ge3)
    )
then
    System.out.println("Detektovan duh: " + $g.getName());
    // Ovde možeš dodati logiku da se rezultat sačuva u neku globalnu listu
end

end template